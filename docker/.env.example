# 018-BrowseKit / docker 环境变量示例
# 用法：复制为 .env 后填写；.env 不进版本库、不外传、不打印明文。

# ---- DeepSeek（OpenAI 兼容）----
OPENAI_API_BASE_URLS=https://api.deepseek.com/v1
OPENAI_API_KEYS=REPLACE_WITH_YOUR_DEEPSEEK_API_KEY

# ---- 其他模型后端 ----
ENABLE_OLLAMA_API=false

# ---- 会话与工具服务密钥（32 位十六进制随机串）----
WEBUI_SECRET_KEY=REPLACE_WITH_RANDOM_32_HEX
MCPO_API_KEY=REPLACE_WITH_RANDOM_32_HEX

# ---- 注册开关 ----
# 仅为本地单人使用，初始需要一次注册来创建管理员账号；建号后建议改回 false
ENABLE_SIGNUP=true
